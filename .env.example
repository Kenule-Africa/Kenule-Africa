# Copy this file to .env and replace the placeholders.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser code or commit real credentials.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL connection for applying backend/migrations/001_initial_schema.sql.
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Initial administrator. The seed script hashes the password and never overwrites
# an existing administrator password hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=generate-at-least-32-random-bytes-and-keep-this-private
# Optional expected origin for deployments behind a proxy; leave blank locally.
APP_ORIGIN=
